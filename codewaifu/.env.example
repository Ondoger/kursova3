# ── Frontend (exposed to the browser, must be prefixed with VITE_) ──
# Optional: enables "Sign in with GitHub" on the landing page.
VITE_GITHUB_CLIENT_ID=

# ── Backend (Vercel functions only — NEVER prefix with VITE_) ──

# MongoDB Atlas connection string. Get it from:
#   Atlas → Cluster → Connect → Drivers → "Node.js"
# Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/gitquest?retryWrites=true&w=majority
MONGODB_URI=

# JWT signing secret (>=32 random chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# GitHub OAuth (server-side, used by /api/github/oauth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: enables /api/auth/dev-login in production for demo accounts.
ENABLE_DEMO_LOGIN=

# Resend (email delivery for verification codes). Get from resend.com.
RESEND_API_KEY=
# From-address. Must be on a verified domain, or use Resend's sandbox:
#   onboarding@resend.dev
EMAIL_FROM="GitQuest <onboarding@resend.dev>"
